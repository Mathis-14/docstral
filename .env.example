# API key used for Mistral embeddings and generation.
MISTRAL_API_KEY=

# Optional Google OAuth; required when starting with --auth google.
DOCSTRAL_GOOGLE_CLIENT_ID=
DOCSTRAL_GOOGLE_CLIENT_SECRET=
DOCSTRAL_OAUTH_BASE_URL=http://localhost:8000
DOCSTRAL_ALLOWED_EMAILS=
# Generate once with: openssl rand -hex 32
DOCSTRAL_OAUTH_SIGNING_KEY=
# Persist this directory; mount a writable volume here in Docker.
FASTMCP_HOME=data/oauth
